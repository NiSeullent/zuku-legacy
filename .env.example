# Existing ZUKU API. TLS required except for loopback.
ZUKU_API_ORIGIN=http://127.0.0.1:30012
ZUKU_MODERN_ORIGIN=https://www.zuzunza.com
PORT=8787
HOST=127.0.0.1
# Generate using: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never commit a real key; use the same value on the server and local bridge.
# ZUKU_BRIDGE_KEY=
# Browser accesses http://127.0.0.1:8788/ through the local companion.
# ZUKU_LEGACY_UPSTREAM=https://your-legacy-host.example
# ZUKU_BRIDGE_PORT=8788
# Optional direct TLS for standalone server:
# ZUKU_TLS_CERT=/absolute/path/cert.pem
# ZUKU_TLS_KEY=/absolute/path/key.pem
# Host must exactly match this origin; set when using an ingress/custom hostname.
# ZUKU_PUBLIC_ORIGIN=https://your-legacy-host.example
# Separate from bridge key. Ingress must OVERWRITE the header, not preserve clients' values.
# ZUKU_HTTPS_PROXY_SECRET=
