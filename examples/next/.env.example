# The same canonical modern HTTPS host serves /legacy and /legacy/approve.
ZUKU_PUBLIC_ORIGIN=https://localhost:3000
ZUKU_MODERN_ORIGIN=https://localhost:3000
ZUKU_API_ORIGIN=http://127.0.0.1:30012

# Optional: >=32 random bytes encoded as hexadecimal, server and HTTPS ingress only.
# The ingress must REMOVE any client value and inject this only on verified HTTPS.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ZUKU_HTTPS_PROXY_SECRET=

# Optional independently authenticated local companion transport.
# ZUKU_BRIDGE_KEY=
